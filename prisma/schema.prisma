// TTC HR Portal — data model
// Design notes:
// - `Employee.userId` is the Supabase Auth user id (uuid). Auth identity/session/password
//   handling lives entirely in Supabase Auth — this schema never stores credentials.
// - Every table an employee should NOT freely read/write also gets a Postgres row-level
//   security (RLS) policy (see prisma/rls.sql) as a second enforcement layer behind the
//   application's own server-side authorization checks in src/lib/authorization.ts.
// - Nothing here stores SSNs, bank details, or payroll credentials — see Section 13 of the
//   project brief. Payroll math itself is out of scope; this schema only holds APPROVED hours.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core identity & org structure
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  SUPERVISOR
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  FORMER_EMPLOYEE
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  employees     Employee[]
  documents     DocumentAssignment[]
  announcements AnnouncementAudience[]
}

model Employee {
  id               String            @id @default(uuid())
  // Supabase Auth user id (auth.users.id). Unique — one portal account per employee.
  userId           String            @unique
  employeeCode     String            @unique // human-friendly ID, e.g. for payroll export
  firstName        String
  lastName         String
  preferredName    String?
  jobTitle         String
  role             Role              @default(EMPLOYEE)
  employmentStatus EmploymentStatus  @default(ACTIVE)
  hireDate         DateTime

  // Storage key (path within the "avatars" Supabase Storage bucket, NOT a URL) for this
  // employee's profile photo — null until they have one. Kept as a bare key rather than a
  // stored URL for the same reason storageKey is used on Document: the bucket is a Supabase
  // implementation detail that can move, and src/lib/storage.ts's getAvatarPublicUrl() is the
  // one place that turns a key into a real URL. Unlike Document's storageKey, this bucket is
  // PUBLIC (see README "Profile photo bucket") — an admin-uploaded headshot isn't confidential
  // the way HR documents are, and it needs to render as a plain <img src> in lists (Employees
  // admin, Directory, Team) without minting a signed URL per row on every page load.
  avatarStorageKey String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Self-referencing: an employee's supervisor is another employee.
  supervisorId String?
  supervisor   Employee?  @relation("SupervisorToReports", fields: [supervisorId], references: [id])
  reports      Employee[] @relation("SupervisorToReports")

  ttcEmail       String  @unique
  workPhone      String?
  personalPhone  String?
  personalEmail  String?

  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?

  deactivatedAt DateTime? // set the instant HR ends access; checked on every request

  // Which Quick Actions tiles this person has chosen to keep on their own dashboard — CB,
  // round five: "I should be able to customize what quick actions is there... based off of
  // what's available in the more tab." Stable keys (see src/lib/quick-actions.ts), not
  // hrefs/labels, so a route rename doesn't silently drop someone's saved picks. Empty means
  // "never customized" — the dashboard falls back to the plain defaults (defaultQuickActionKeys)
  // rather than showing nothing.
  quickActionKeys String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries          TimeEntry[]
  timeEntryAuditEvents TimeEntryAuditEvent[] @relation("ActorOnTimeEntryAudit")
  ptoRequestsMade      PtoRequest[]          @relation("PtoRequester")
  ptoRequestsReviewed  PtoRequest[]          @relation("PtoReviewer")
  documentAssignments  DocumentAssignment[]
  acknowledgments      DocumentAcknowledgment[]
  documentFoldersCreated DocumentFolder[]
  onboarding           EmployeeOnboarding?
  availabilitySubmissions AvailabilitySubmission[] @relation("AvailabilitySubject")
  availabilityReviewed    AvailabilitySubmission[] @relation("AvailabilityReviewer")
  shiftsAsEmployee        Shift[]                   @relation("ShiftEmployee")
  shiftsCreated           Shift[]                   @relation("ShiftCreatedBy")
  shiftsReviewed          Shift[]                   @relation("ShiftReviewer")
  teamNotesAsSubject      TeamNote[]                @relation("TeamNoteSubject")
  teamNotesWritten        TeamNote[]                @relation("TeamNoteAuthor")
  directMessagesSent      DirectMessage[]           @relation("DirectMessageSender")
  directMessagesReceived  DirectMessage[]           @relation("DirectMessageRecipient")
  directMessageReactions  DirectMessageReaction[]
  directMessageCommentsWritten DirectMessageComment[] @relation("DirectMessageCommentAuthor")
  dateTasksAsSubject      DateTask[]                @relation("DateTaskSubject")
  dateTasksCreated        DateTask[]                @relation("DateTaskCreatedBy")
  dateTasksApproved       DateTask[]                @relation("DateTaskApprovedBy")
  dateTasksReturned       DateTask[]                @relation("DateTaskReturnedBy")
  dateTaskCommentsWritten DateTaskComment[]          @relation("DateTaskCommentAuthor")
  onboardingReadinessItems OnboardingReadinessItem[]
  onboardingCheckpoints    OnboardingCheckpoint[]
  certificationAttempts    CertificationAttempt[]
  announcementsWritten Announcement[]        @relation("AnnouncementAuthor")
  announcementAudiences AnnouncementAudience[]
  auditLogEntries      AuditLog[]            @relation("ActorOnAuditLog")
  notifications        Notification[]        @relation("NotificationRecipient")
  messageReadStates    MessageReadState[]
  dashboardDismissals  DashboardDismissal[]

  @@index([supervisorId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Time & Attendance
// ---------------------------------------------------------------------------

enum TimeEntryStatus {
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  RETURNED
  MISSING_ENTRY
}

model TimeEntry {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  workDate     DateTime // date only, stored at midnight UTC for the employee's work day

  totalMinutes Int?

  status TimeEntryStatus @default(IN_PROGRESS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    TimeSession[]
  auditEvents TimeEntryAuditEvent[]

  @@unique([employeeId, workDate]) // one entry per employee per day
  @@index([employeeId, workDate])
}

model TimeSession {
  id          String    @id @default(uuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  clockIn  DateTime
  clockOut DateTime?

  reminderSentAt DateTime?

  shiftId String?
  shift   Shift?  @relation("ShiftTimeSessions", fields: [shiftId], references: [id], onDelete: SetNull)

  isException     Boolean @default(false)
  exceptionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timeEntryId])
  @@index([shiftId])
}

enum TimeAuditAction {
  ENTRY_CREATED
  CLOCK_IN
  LUNCH_STARTED
  LUNCH_ENDED
  CLOCK_OUT
  EMPLOYEE_CORRECTION_REQUESTED
  SUPERVISOR_CORRECTION
  HR_CORRECTION
  TIMESHEET_APPROVED
  TIMESHEET_RETURNED
  AUTO_CLOCK_OUT
}

// Append-only: prisma/rls.sql grants no UPDATE/DELETE policy on this table to anyone, so an
// audit row can never be edited or removed on its own once written. `onDelete: Cascade` is the
// one exception — when the entry itself is deleted wholesale (see deleteEmployeeTimeEntry in
// src/lib/time-actions.ts), its audit rows go with it, the same way its TimeSession rows already
// do. That's safe specifically because PostgreSQL's foreign-key referential actions always
// bypass row security, so the cascade fires with no delete policy required (see the 2026-09-22
// migration for the full reasoning) — the append-only guarantee still holds for every entry that
// isn't being deleted.
model TimeEntryAuditEvent {
  id          String           @id @default(uuid())
  timeEntryId String
  timeEntry   TimeEntry        @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  action      TimeAuditAction
  actorId     String?
  actor       Employee?        @relation("ActorOnTimeEntryAudit", fields: [actorId], references: [id])

  fieldName   String?
  oldValue    String?
  newValue    String?
  comment     String?

  createdAt   DateTime         @default(now())

  @@index([timeEntryId])
}

// ---------------------------------------------------------------------------
// PTO
// ---------------------------------------------------------------------------

enum PtoType {
  VACATION
  SICK
  PERSONAL
  OTHER_APPROVED_LEAVE
}

enum PtoStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model PtoRequest {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("PtoRequester", fields: [employeeId], references: [id])

  type      PtoType
  startDate DateTime
  endDate   DateTime
  hours     Float
  reason    String?

  status     PtoStatus @default(PENDING)
  reviewedById String?
  reviewedBy   Employee? @relation("PtoReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}
enum AvailabilityStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  ADJUSTMENT_REQUESTED
  REMOVED
}

model AvailabilitySubmission {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("AvailabilitySubject", fields: [employeeId], references: [id])

  slots Json

  note String?

  status        AvailabilityStatus @default(PENDING)
  submittedAt   DateTime           @default(now())
  reviewedById  String?
  reviewedBy    Employee?          @relation("AvailabilityReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?

  adjustedSlots Json?

  // Correction round (Sept 2026), CB: "each scheduled day may have different requests... you
  // have to approve each thing, like each date one at a time, or I have the option to approve
  // everything at one time." One entry per date in `slots`, seeded PENDING at submission time:
  // {date, status: "PENDING"|"APPROVED"|"DENIED", decidedAt?, decidedById?, comment?} — see
  // decideAvailabilityDate in src/lib/availability.ts.
  dateDecisions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shiftReminders AvailabilityShiftReminder[]
  shifts Shift[]

  @@index([employeeId])
  @@index([status])
}

model AvailabilityShiftReminder {
  id           String                 @id @default(uuid())
  submissionId String
  submission   AvailabilitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  date         String
  sentAt       DateTime               @default(now())

  @@unique([submissionId, date])
}

enum ShiftStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CHANGE_REQUESTED
  CANCELLATION_REQUESTED
  CANCELLED
  REASSIGNED
  MISSED
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("ShiftEmployee", fields: [employeeId], references: [id])

  date      String
  startTime String
  endTime   String

  status ShiftStatus @default(UPCOMING)

  note String?

  sourceAvailabilitySubmissionId String?
  sourceAvailabilitySubmission   AvailabilitySubmission? @relation(fields: [sourceAvailabilitySubmissionId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   Employee @relation("ShiftCreatedBy", fields: [createdById], references: [id])

  changeReason      String?
  requestedDate     String?
  requestedStartTime String?
  requestedEndTime   String?

  cancelledAt  DateTime?
  cancelReason String?

  requestedAt DateTime?

  reviewedById  String?
  reviewedBy    Employee? @relation("ShiftReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?

  reassignedFromShiftId String? @unique
  reassignedFromShift   Shift?  @relation("ShiftReassignment", fields: [reassignedFromShiftId], references: [id])
  reassignedToShift     Shift?  @relation("ShiftReassignment")

  timeSessions TimeSession[] @relation("ShiftTimeSessions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date])
  @@index([employeeId, status])
  @@index([status])
  @@index([date])
}

model TeamNote {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("TeamNoteSubject", fields: [employeeId], references: [id])
  authorId   String
  author     Employee @relation("TeamNoteAuthor", fields: [authorId], references: [id])

  body           String
  attachmentKey  String?
  attachmentName String?

  topicType String?
  topicId   String?
  topicDate String?

  createdAt DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([employeeId, topicType, topicId, topicDate, createdAt])
}

model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      Employee @relation("DirectMessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   Employee @relation("DirectMessageRecipient", fields: [recipientId], references: [id])

  body           String
  attachmentKey  String?
  attachmentName String?

  refType String?
  refId   String?
  refDate String?

  // CB, Sept 2026: "I should be able to reply to a specific message within the message thread."
  // A nullable self-relation — ON DELETE SET NULL rather than RESTRICT/CASCADE, since nothing in
  // this app deletes a DirectMessage today, but if that ever changes, a reply should keep
  // reading (just losing its quoted preview) instead of blocking or vanishing with the original.
  replyToId String?
  replyTo   DirectMessage?  @relation("DirectMessageReply", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies   DirectMessage[] @relation("DirectMessageReply")

  // CB, Sept 2026: "I should have the options to include emojis to react to other people's
  // replies." See DirectMessageReaction's own doc comment below for why this is a separate table
  // rather than columns here.
  reactions DirectMessageReaction[]

  /** Phase 5c (CB, Sept 2026): "an option to add an internal comment" — see
   *  DirectMessageComment's own doc comment just below for the full scope. */
  comments DirectMessageComment[]

  createdAt DateTime @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@index([replyToId])
}

/**
 * One person's quick-emoji reaction to one DirectMessage — CB, Sept 2026: "I should have the
 * options to include emojis to react to other people's replies." One row per (message, person,
 * emoji): the unique constraint below means a second call with the SAME emoji is what
 * toggleReaction (src/lib/direct-messages.ts) treats as "remove it," while a DIFFERENT emoji from
 * the same person adds a second reaction rather than replacing the first — same as a real chat
 * app's tapback, not a single "your one reaction" slot per person. `emoji` is validated app-side
 * against QUICK_REACTION_EMOJIS (src/types/index.ts), the same "validate in the action function,
 * not the column type" convention this app already uses for PtoType's own options.
 */
model DirectMessageReaction {
  id String @id @default(uuid())

  messageId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, employeeId, emoji])
  @@index([messageId])
}

/** Phase 5c (CB, Sept 2026): "hovering over a message should show quick emoji reactions and an
 *  option to add an internal comment" — confirmed scope: "hidden from the team member." A staff-
 *  only aside on one DM, never visible to (or postable by) whichever side of that conversation
 *  holds plain EMPLOYEE role — see isStaff() in src/lib/authorization.ts for the exact cut
 *  (SUPER_ADMIN/HR_ADMIN/SUPERVISOR all count as staff here, same three roles canAccessReports
 *  already draws the line at) and direct_message_comment_select/_insert in prisma/rls.sql for
 *  the database-level backstop. Deliberately flat (no reply-to-a-comment, no reactions-on-a-
 *  comment) and delete-less, same shape DateTaskComment already uses for a task's own comment
 *  thread — this is a note, not a second chat. Cascades with its message like every other DM
 *  child row (reactions, above). */
model DirectMessageComment {
  id        String        @id @default(uuid())
  messageId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee      @relation("DirectMessageCommentAuthor", fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
}

enum DateTaskStatus {
  ASSIGNED
  IN_PROGRESS
  AWAITING_REVIEW
  APPROVED
  RETURNED
}

// QA pass (Sept 2026), CB: a simple priority indicator on a task, so an urgent item catches the
// reviewer's/employee's eye in the list without turning task assignment into a bigger
// planning/estimation feature. Two levels only (NORMAL/URGENT).
enum DateTaskPriority {
  NORMAL
  URGENT
}

model DateTask {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("DateTaskSubject", fields: [employeeId], references: [id])

  createdById String
  createdBy   Employee @relation("DateTaskCreatedBy", fields: [createdById], references: [id])

  taskDate String

  title       String
  description String

  attachmentKey  String?
  attachmentName String?

  status DateTaskStatus @default(ASSIGNED)

  // QA pass (Sept 2026): a simple priority flag, set at assignment time by whoever creates the
  // task (createDateTask) — never changes on its own afterward, same "set once, read many"
  // shape as everything else recorded at creation on this model.
  priority DateTaskPriority @default(NORMAL)

  startedAt   DateTime?
  submittedAt DateTime?

  approvedById String?
  approvedBy   Employee? @relation("DateTaskApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  returnedById String?
  returnedBy   Employee? @relation("DateTaskReturnedBy", fields: [returnedById], references: [id])
  returnedAt   DateTime?
  returnNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments DateTaskComment[]

  @@index([employeeId, taskDate])
  @@index([employeeId, status])
}

model DateTaskComment {
  id     String   @id @default(uuid())
  taskId String
  task   DateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   Employee @relation("DateTaskCommentAuthor", fields: [authorId], references: [id])

  body           String
  attachmentKey  String?
  attachmentName String?

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

enum DocumentCategory {
  EMPLOYEE_HANDBOOK
  HR_POLICY
  JOB_DESCRIPTION
  OFFER_LETTER
  PERFORMANCE_REVIEW
  TRAINING
  EMPLOYEE_FORM
  CONFIDENTIAL_EMPLOYEE_DOCUMENT
  NDA_AGREEMENT
  CODE_OF_CONDUCT
  MEDIA_RELEASE
  OTHER
}

enum DocumentVisibility {
  GLOBAL
  DEPARTMENT
  INDIVIDUAL
  CONFIDENTIAL_HR
}

model DocumentFolder {
  id   String @id @default(uuid())
  name String

  parentFolderId String?
  parentFolder   DocumentFolder?  @relation("DocumentFolderChildren", fields: [parentFolderId], references: [id])
  childFolders   DocumentFolder[] @relation("DocumentFolderChildren")

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([parentFolderId])
}

model Document {
  id          String             @id @default(uuid())
  title       String
  category    DocumentCategory
  visibility  DocumentVisibility
  version     Int                @default(1)
  storageKey  String
  requiresAcknowledgment Boolean @default(false)
  archivedAt  DateTime?

  folderId String?
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments             DocumentAssignment[]
  acknowledgments         DocumentAcknowledgment[]
  onboardingItems         OnboardingItem[]
  onboardingTemplateItems OnboardingTemplateItem[]

  @@index([folderId])
}

model DocumentAssignment {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])

  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([employeeId])
  @@index([departmentId])
}

model DocumentAcknowledgment {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  documentVersion Int
  acknowledgedAt  DateTime @default(now())

  @@unique([documentId, employeeId, documentVersion])
}
enum OnboardingItemStatus {
  NOT_STARTED
  AWAITING_APPROVAL
  RETURNED
  COMPLETED
}

enum OnboardingItemType {
  TASK
  DOCUMENT
  TRAINING
  MEETING
  CERTIFICATION
}

model EmployeeOnboarding {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  startedAt   DateTime @default(now())
  completedAt DateTime?

  items OnboardingItem[]
}

model OnboardingItem {
  id           String                @id @default(uuid())
  onboardingId String
  onboarding   EmployeeOnboarding    @relation(fields: [onboardingId], references: [id])

  label        String
  description  String?
  itemType     OnboardingItemType    @default(TASK)
  status       OnboardingItemStatus  @default(NOT_STARTED)
  dueDate      DateTime?
  sortOrder    Int                   @default(0)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  submittedAt  DateTime?
  completedAt  DateTime?
  completedBy  String?

  approvedBy   String?
  approvedAt   DateTime?
  returnReason String?

  certificationAttempts CertificationAttempt[]

  @@index([onboardingId])
  @@index([documentId])
}

model OnboardingTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items OnboardingTemplateItem[]
}

model OnboardingTemplateItem {
  id         String             @id @default(uuid())
  templateId String
  template   OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  label       String
  description String?
  itemType    OnboardingItemType @default(TASK)
  sortOrder   Int                @default(0)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  dueOffsetDays Int?

  @@index([templateId])
  @@index([documentId])
}

model OnboardingReadinessItem {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  label     String
  sortOrder Int    @default(0)

  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

enum OnboardingCheckpointStatus {
  PENDING
  COMPLETED
}

model OnboardingCheckpoint {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  milestone String
  dueDate   DateTime
  status    OnboardingCheckpointStatus @default(PENDING)

  notes              String?
  followUpNeeded     Boolean @default(false)
  trainingMilestones String?
  developmentGoals   String?

  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

enum CertificationQuestionType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  CHECKBOX_ALL
  LIST_MATCH
  SHORT_ANSWER
}

model CertificationQuestion {
  id      String @id @default(uuid())
  number  Int    @unique
  section String
  sortOrder Int
  prompt  String
  type    CertificationQuestionType
  points  Int

  options Json?
  correctOptionKeys String[]

  acceptedAnswers    String[]
  requiredMatchCount Int?

  rubric String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  responses CertificationResponse[]

  @@index([active])
}

enum CertificationAttemptStatus {
  SUBMITTED
  PASSED
  FAILED
}

model CertificationAttempt {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  onboardingItemId String?
  onboardingItem   OnboardingItem? @relation(fields: [onboardingItemId], references: [id])

  status      CertificationAttemptStatus @default(SUBMITTED)
  submittedAt DateTime                   @default(now())

  objectivePointsEarned   Int
  objectivePointsPossible Int
  totalPointsPossible     Int

  manualPointsEarned Int?
  finalScorePercent  Float?

  passThresholdPercent Float @default(85)

  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())

  responses CertificationResponse[]

  @@index([employeeId])
  @@index([onboardingItemId])
}

model CertificationResponse {
  id         String                @id @default(uuid())
  attemptId  String
  attempt    CertificationAttempt  @relation(fields: [attemptId], references: [id])
  questionId String
  question   CertificationQuestion @relation(fields: [questionId], references: [id])

  answerText   String?
  selectedKeys String[]

  isAutoScored   Boolean  @default(false)
  isCorrect      Boolean?
  pointsEarned   Int?
  pointsPossible Int

  needsManualReview Boolean   @default(false)
  reviewOutcome     String?
  reviewComment     String?
  reviewedAt        DateTime?
  reviewedBy        String?

  @@index([attemptId])
  @@index([questionId])
}

model Announcement {
  id             String    @id @default(uuid())
  title          String
  message        String
  authorId       String
  author         Employee  @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  publishDate    DateTime  @default(now())
  expirationDate DateTime?
  createdAt      DateTime  @default(now())

  audiences AnnouncementAudience[]

  @@index([publishDate])
}

model AnnouncementAudience {
  id             String        @id @default(uuid())
  announcementId String
  announcement   Announcement  @relation(fields: [announcementId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id])

  @@index([announcementId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     Employee @relation("ActorOnAuditLog", fields: [actorId], references: [id])

  action    String
  targetType String
  targetId  String
  oldValue  String?
  newValue  String?
  comment   String?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}
enum NotificationType {
  SHIFT_CREATED
  SHIFT_CANCELLED
  SHIFT_REASSIGNED
  SHIFT_CHANGE_APPROVED
  SHIFT_REQUEST_DECLINED
  SHIFT_REQUEST_RECEIVED
  AVAILABILITY_APPROVED
  AVAILABILITY_DENIED
  AVAILABILITY_ADJUSTMENT_PROPOSED
  PTO_APPROVED
  PTO_DENIED
  DATE_TASK_ASSIGNED
  DATE_TASK_APPROVED
  DATE_TASK_RETURNED
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   Employee @relation("NotificationRecipient", fields: [recipientId], references: [id])

  type  NotificationType
  title String
  body  String?

  targetType String
  targetId   String

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model MessageReadState {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  threadKey  String
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, threadKey])
  @@index([employeeId])
}

model DashboardDismissal {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  key         String
  dismissedAt DateTime @default(now())

  @@unique([employeeId, key])
}
