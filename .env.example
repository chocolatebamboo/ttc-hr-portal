# Copy to .env.local for local development. In Vercel, set these as encrypted Project
# Environment Variables instead — never commit a real .env file.

# --- Database (Supabase Postgres) ---
# The RUNNING APP connects as the restricted `app_user` role created in prisma/rls.sql —
# never as the Supabase "postgres" superuser, or Row-Level Security silently does nothing.
DATABASE_URL="postgresql://app_user:REPLACE_ME@<project>.supabase.co:5432/postgres"

# Only `prisma migrate` uses this — the elevated connection Supabase gives you by default.
# Not read by the running app; do not put it in the deployed environment's runtime config.
MIGRATE_DATABASE_URL="postgresql://postgres:<password>@<project>.supabase.co:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# SERVER-ONLY. The app's own real deployed URL (no trailing slash) — used ONLY to build the
# link inside invite/resend-invite emails (src/lib/employees-admin.ts's inviteRedirectUrl).
# Without this, Supabase falls back to whatever "Site URL" is set in the Supabase dashboard
# (Authentication → URL Configuration), which defaults to http://localhost:3000 and silently
# sends every real invitee to a URL that only works on a dev machine — inviteRedirectUrl
# throws a clear error instead of letting that happen quietly again. Set this to the exact
# same URL you add to the Supabase dashboard's Site URL / Redirect URLs (see
# ADMINISTRATOR_INSTRUCTIONS.md's "Signing in" section for that dashboard step).
SITE_URL="https://ttc-hr-portal.onrender.com"

# --- Supabase Storage (Document Center) ---
# SERVER-ONLY — never prefix this with NEXT_PUBLIC_, never send it to the browser, never log
# it. It bypasses Supabase's own storage rules entirely, so the only thing standing between
# an employee and someone else's document is the authorization check in src/lib/documents.ts
# running BEFORE this key is ever used (see src/lib/supabase/admin.ts). From Supabase Project
# Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# --- Reminder emails (POST /api/cron/clockout-reminders, POST /api/cron/shift-reminders) ---
# Shared by both scheduled reminder jobs — "you're still clocked in" (src/lib/
# clockout-reminders.ts) and "your shift starts soon" (src/lib/shift-reminders.ts) — not
# one-per-job. From https://resend.com after verifying a sending domain (their dashboard walks
# you through the DNS records). Leave unset and both jobs just skip sending email — the
# clock-out job's in-app banner on the Home page still works either way (there's no in-app
# equivalent for shift reminders).
RESEND_API_KEY="<resend-api-key>"
# Must include a real address at a domain you've verified with Resend, or delivery is limited
# to your own Resend account's email. Defaults to Resend's shared sandbox sender if unset.
EMAIL_FROM="TTC HR Portal <notifications@yourdomain.org>"
# A random string only the scheduled workflow and this app know — proves a request to any of the
# three cron endpoints (clockout-reminders, shift-reminders, and POST /api/cron/auto-clockout —
# src/lib/auto-clockout.ts, force-closes a session left open past 4 hours; doesn't send email, so
# it doesn't need RESEND_API_KEY, but it's gated by this same secret) is really the scheduled job
# and not a stranger on the internet. Generate one with `openssl rand -hex 32` or similar;
# there's no "right" value, just keep it secret. All three cron endpoints check the same
# CRON_SECRET — they don't need separate ones.
CRON_SECRET="<random-secret>"
