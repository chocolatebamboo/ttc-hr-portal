# Copy to .env.local for local development. In Vercel, set these as encrypted Project
# Environment Variables instead — never commit a real .env file.

# --- Database (Supabase Postgres) ---
# The RUNNING APP connects as the restricted `app_user` role created in prisma/rls.sql —
# never as the Supabase "postgres" superuser, or Row-Level Security silently does nothing.
DATABASE_URL="postgresql://app_user:REPLACE_ME@<project>.supabase.co:5432/postgres"

# Only `prisma migrate` uses this — the elevated connection Supabase gives you by default.
# Not read by the running app; do not put it in the deployed environment's runtime config.
MIGRATE_DATABASE_URL="postgresql://postgres:<password>@<project>.supabase.co:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# --- Supabase Storage (Document Center) ---
# SERVER-ONLY — never prefix this with NEXT_PUBLIC_, never send it to the browser, never log
# it. It bypasses Supabase's own storage rules entirely, so the only thing standing between
# an employee and someone else's document is the authorization check in src/lib/documents.ts
# running BEFORE this key is ever used (see src/lib/supabase/admin.ts). From Supabase Project
# Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# --- Clock-out reminder emails (POST /api/cron/clockout-reminders) ---
# From https://resend.com after verifying a sending domain (their dashboard walks you through
# the DNS records). Leave unset and the reminder job just skips sending email — the in-app
# banner on the Home page still works either way.
RESEND_API_KEY="<resend-api-key>"
# Must include a real address at a domain you've verified with Resend, or delivery is limited
# to your own Resend account's email. Defaults to Resend's shared sandbox sender if unset.
EMAIL_FROM="TTC HR Portal <notifications@yourdomain.org>"
# A random string only Render's Cron Job and this app know — proves a request to the cron
# endpoint above is really the scheduled job and not a stranger on the internet. Generate one
# with `openssl rand -hex 32` or similar; there's no "right" value, just keep it secret.
CRON_SECRET="<random-secret>"
